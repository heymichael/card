{
  "name": "card_editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "docs:prepare": "python3 scripts/generate_docs_pages.py && node scripts/generate_docs_auth_runtime.mjs && bash scripts/sync_docs.sh",
    "local:docs:serve": "npm run docs:prepare && firebase serve --port 5001",
    "build": "tsc -b && vite build && cp public/_redirects dist/_redirects",
    "lint": "eslint . && npm run lint:colors",
    "lint:colors": "node ./check-color-tokens.mjs",
    "preview": "vite preview",
    "test:e2e:app": "playwright test --config=playwright.app.config.ts",
    "test:e2e:docs": "playwright test --config=playwright.docs.config.ts",
    "test:e2e:app:smoke": "npm run test:e2e:app -- --grep \"@smoke\"",
    "test:e2e:docs:smoke": "npm run test:e2e:docs -- --grep \"@smoke\"",
    "test:e2e:docs:smoke:local": "PLAYWRIGHT_BROWSERS_PATH=$HOME/.cache/ms-playwright PLAYWRIGHT_USE_EXTERNAL_BASE_URL=1 E2E_BASE_URL=http://localhost:5002 npm run test:e2e:docs:smoke",
    "test:e2e:docs:regression": "npm run test:e2e:docs -- --grep \"@regression\"",
    "test:e2e:docs:prod-monitor": "npm run test:e2e:docs -- --grep \"@prod-monitor\"",
    "check:contract": "node scripts/checks/contract-check.mjs",
    "check:artifact": "node scripts/checks/artifact-check.mjs",
    "report:test-status": "node scripts/test-status/generate-suite-report.mjs",
    "report:playwright-to-docs": "bash scripts/copy-playwright-report-to-docs.sh",
    "check:docs-sync": "python3 scripts/generate_docs_pages.py && node scripts/generate_docs_auth_runtime.mjs && bash scripts/sync_docs.sh && git diff --exit-code -- docs hosting/public/docs"
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "konva": "^10.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
